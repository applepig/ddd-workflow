{
  "name": "agents",
  "version": "0.1.0",
  "description": "DDD 工作流跨 AI agent CLI 安裝工具",
  "type": "module",
  "scripts": {
    "deploy": "node scripts/build.js && node scripts/cli.js deploy",
    "deploy:claude": "node scripts/cli.js deploy claude",
    "deploy:gemini": "node scripts/build.js && node scripts/cli.js deploy gemini",
    "deploy:codex": "node scripts/build.js && node scripts/cli.js deploy codex",
    "deploy:opencode": "node scripts/build.js && node scripts/cli.js deploy opencode",
    "undeploy": "node scripts/cli.js undeploy",
    "undeploy:claude": "node scripts/cli.js undeploy claude",
    "undeploy:gemini": "node scripts/cli.js undeploy gemini",
    "undeploy:codex": "node scripts/cli.js undeploy codex",
    "undeploy:opencode": "node scripts/cli.js undeploy opencode",
    "test": "node scripts/cli.js test",
    "test:unit": "vitest run",
    "build": "node scripts/build.js"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "vitest": "^4.1.2"
  }
}
